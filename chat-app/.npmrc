@noahsark:registry=https://gitlab.noahsark.me/api/v4/projects/63/packages/npm/
//gitlab.noahsark.me/api/v4/projects/63/packages/npm/:_authToken=${NPM_TOKEN}
# Host-level token: GitLab's tarball URL repeats the scope
# (@noahsark/constellation/-/@noahsark/constellation-x.y.z.tgz), which trips
# npm's path-prefix auth matching so the project-scoped line above is not
# attached to the tarball GET (401). A host-wide entry attaches the token to
# every gitlab.noahsark.me request, covering the tarball. pnpm/bun don't need
# this; npm does.
//gitlab.noahsark.me/:_authToken=${NPM_TOKEN}
legacy-peer-deps=true
